    "calibguard",
    "security",
    "malware-detection"
  ],
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maomitgd2006/DSH_CG.git"
  },
  "homepage": "https://github.com/maomitgd2006/DSH_CG#readme",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
